{
  "name": "placekeepers-web",
  "version": "0.0.1",
  "private": true,
  "description": "Placekeepers map: a free public map for Philadelphia neighbors and organizers.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "PK_E2E=1 vite build",
    "preview:e2e": "PK_E2E=1 vite preview --port 4317 --strictPort",
    "e2e": "playwright test",
    "basemap": "bash scripts/make-basemap.sh"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^24.8.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.1",
    "marked": "^18.0.14",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
